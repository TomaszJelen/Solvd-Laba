<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvd.laba.library.mybatis.IMappers.IMapperBook">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" parameterType="solvd.laba.library.model.Book">
        INSERT INTO books (bookshelves_id, title) VALUES (#{bookshelfId}, #{title})
    </insert>
    <insert id="insertToGenres" useGeneratedKeys="true" keyProperty="id" >
        INSERT INTO books_has_genres (books_id, genres_id) VALUES (#{bookId}, #{genreId})
    </insert>
    <insert id="insertToAuthors" useGeneratedKeys="true" keyProperty="id" >
        INSERT INTO books_has_authors (books_id, authors_id) VALUES (#{bookId}, #{authorId})
    </insert>
    <update id="change" parameterType="solvd.laba.library.model.Book">
        UPDATE books SET bookshelves_id = #{bookshelfId}, title = #{title} WHERE id = #{id}
    </update>
    <select id="readAll" resultType="solvd.laba.library.model.Book">
        SELECT * FROM books
    </select>
    <select id="read" parameterType="long" resultType="solvd.laba.library.model.Book">
        SELECT * FROM books WHERE id = #{id}
    </select>
    <select id="readByBookshelf" parameterType="long" resultType="solvd.laba.library.model.Book">
        SELECT * FROM books WHERE bookshelves_id = #{bookshelfId}
    </select>
    <delete id="remove" parameterType="long">
        DELETE FROM books WHERE id = #{id}
    </delete>
    <delete id="removeReferenceToAuthors" parameterType="long">
        DELETE FROM books_has_authors WHERE books_id = #{id}
    </delete>
    <delete id="removeReferenceToGenres" parameterType="long">
        DELETE FROM books_has_genres WHERE books_id = #{id}
    </delete>
</mapper>