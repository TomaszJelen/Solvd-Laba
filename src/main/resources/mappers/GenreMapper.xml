<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvd.laba.library.mybatis.IMappers.IMapperGenre">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" parameterType="solvd.laba.library.model.Genre">
        INSERT INTO genres (name) VALUES (#{name})
    </insert>
    <update id="change" parameterType="solvd.laba.library.model.Genre">
        UPDATE genres SET name = #{name} WHERE id = #{id}
    </update>
    <select id="readAll" resultType="solvd.laba.library.model.Genre">
        SELECT * FROM genres
    </select>
    <select id="read" parameterType="long" resultType="solvd.laba.library.model.Genre">
        SELECT * FROM genres WHERE id = #{id}
    </select>
    <select id="readByBook" parameterType="long" resultType="solvd.laba.library.model.Genre">
        SELECT * FROM genres WHERE id IN (
        SELECT genres_id FROM books_has_genres WHERE books_id = #{bookId})
    </select>
    <delete id="remove" parameterType="long">
        DELETE FROM genres WHERE id = #{id}
    </delete>
    <delete id="removeReference" parameterType="long">
        DELETE FROM books_has_genres WHERE genres_id = #{id}
    </delete>
</mapper>