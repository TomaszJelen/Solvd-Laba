<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvd.laba.library.mybatis.IMappers.IMapperAuthor">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" parameterType="solvd.laba.library.model.Author">
        INSERT INTO authors (name, surname) VALUES (#{name}, #{surname})
    </insert>
    <update id="change" parameterType="solvd.laba.library.model.Author">
        UPDATE authors SET name = #{name}, surname = #{surname} WHERE id = #{id}
    </update>
    <select id="readAll" resultType="solvd.laba.library.model.Author">
        SELECT * FROM authors
    </select>
    <select id="read" parameterType="long" resultType="solvd.laba.library.model.Author">
        SELECT * FROM authors WHERE id = #{id}
    </select>
    <select id="readByBook" parameterType="long" resultType="solvd.laba.library.model.Author">
        SELECT * FROM authors WHERE id IN (
        SELECT authors_id FROM books_has_authors WHERE books_id = #{bookId})
    </select>
    <delete id="remove" parameterType="long">
        DELETE FROM authors WHERE id = #{id};
    </delete>
    <delete id="removeReference" parameterType="long">
            DELETE FROM books_has_authors WHERE authors_id = #{id};
    </delete>
</mapper>